{
  "name": "@ugrc/raster",
  "version": "3.0.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "check": "tsc -b",
    "copy:arcgis": "cpy \"./node_modules/@arcgis/core/assets/**\" ./public/assets",
    "format": "prettier . --write",
    "lint": "eslint . --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "start": "vite",
    "start:ci": "vite --host",
    "storybook": "storybook dev -p 6006",
    "test": "vitest",
    "test:e2e": "playwright test --ui"
  },
  "browserslist": {
    "production": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@arcgis/core": "~5.0.19",
    "@arcgis/lumina": "~5.0.19",
    "@arcgis/map-components": "~5.0.19",
    "@esri/arcgis-rest-feature-service": "^4.11.0",
    "@esri/arcgis-rest-request": "^4.11.0",
    "@tanstack/react-query": "^5.104.3",
    "@ugrc/eslint-config": "^1.3.1",
    "@ugrc/esri-theme-toggle": "^2.0.1",
    "@ugrc/utah-design-system": "^4.3.1",
    "@ugrc/utilities": "^5.0.1",
    "@xstate/react": "^6.1.0",
    "firebase": "^12.19.0",
    "lucide-react": "^1.38.0",
    "react": "^19.3.1",
    "react-aria": "^3.53.1",
    "react-aria-components": "^1.22.1",
    "react-content-loader": "^7.1.2",
    "react-dom": "^19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-stately": "^3.51.0",
    "tailwind-merge": "^3.7.0",
    "usehooks-ts": "^3.1.1",
    "xstate": "^5.33.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@storybook/react-vite": "^10.6.2",
    "@types/node": "^26.4.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@ugrc/tailwind-preset": "^2.0.1",
    "@ugrc/tsconfigs": "^1.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "cpy-cli": "^7.0.0",
    "eslint": "^10.9.1",
    "firebase-tools": "^15.34.1",
    "happy-dom": "^20.14.6",
    "postcss": "^8.5.31",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "storybook": "^10.6.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-package-version": "^1.1.0",
    "vitest": "^4.1.12"
  }
}
